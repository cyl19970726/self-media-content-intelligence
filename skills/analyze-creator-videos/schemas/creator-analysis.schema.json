{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/analyze-creator-videos/creator-analysis.schema.json",
  "title": "Creator analysis",
  "type": "object",
  "required": ["schemaVersion", "creatorId", "analysisContract", "positioning", "tierComparison", "mechanisms", "visualLanguage", "launchSystem", "unknowns", "evidenceBoundary"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "creatorId": { "type": "string", "minLength": 1 },
    "analysisContract": {
      "type": "object",
      "required": ["why", "method", "decisions", "nonDecisions"],
      "properties": {
        "why": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "decisions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "nonDecisions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": true
    },
    "positioning": {
      "type": "object",
      "required": ["name", "sentence", "audience", "job", "promise", "proofSystem", "credibilityDebt"],
      "properties": {
        "name": { "type": "string" },
        "sentence": { "type": "string" },
        "audience": { "type": "string" },
        "job": { "type": "string" },
        "promise": { "type": "string" },
        "proofSystem": { "type": "string" },
        "credibilityDebt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "tierComparison": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tier", "sampleSize", "observedPatterns", "mechanismHypotheses", "failureModes", "evidenceRefs"],
        "properties": {
          "tier": { "enum": ["high", "median", "average", "low"] },
          "sampleSize": { "type": "integer", "minimum": 0 },
          "observedPatterns": { "type": "array", "items": { "type": "string" } },
          "mechanismHypotheses": { "type": "array", "items": { "type": "string" } },
          "failureModes": { "type": "array", "items": { "type": "string" } },
          "evidenceRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "additionalProperties": true
      }
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "hypothesis", "evidenceRefs", "confidence", "experiment"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "hypothesis": { "type": "string" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "confidence": { "enum": ["low", "medium", "high"] },
          "experiment": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "visualLanguage": { "type": "array", "items": { "type": "string" } },
    "launchSystem": {
      "type": "object",
      "required": ["positioning", "lanes", "firstTwelve", "experiments"],
      "properties": {
        "positioning": { "type": "string" },
        "lanes": { "type": "array", "items": { "type": "object" } },
        "firstTwelve": { "type": "array", "items": { "type": "string" } },
        "experiments": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "unknowns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "evidenceBoundary": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
