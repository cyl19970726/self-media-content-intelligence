{
  "name": "self-media-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor/agent-workflow/packages/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite",
    "dev:worker": "SELF_MEDIA_EMBED_WORKERS=false tsx watch apps/worker/src/main.ts",
    "selfmedia": "tsx apps/cli/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:evidence": "node scripts/require-evidence-root.mjs && vitest run",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:repo": "node scripts/check-repository-policy.mjs && node scripts/check-package-boundaries.mjs && node scripts/check-frontend-architecture.mjs && node scripts/check-source-file-lines.mjs",
    "check:frontend-architecture": "node scripts/check-frontend-architecture.mjs",
    "check:frontend-lines": "node scripts/check-frontend-file-lines.mjs",
    "check:source-lines": "node scripts/check-source-file-lines.mjs",
    "check:knowledge-authority": "node scripts/check-knowledge-authority.mjs",
    "check:artifacts": "node scripts/check-artifact-budget.mjs && node scripts/inventory-artifacts.mjs --check docs/evidence/artifact-inventory.json",
    "inventory:artifacts": "node scripts/inventory-artifacts.mjs",
    "evidence:plan": "node scripts/migrate-evidence.mjs plan",
    "evidence:copy": "node scripts/migrate-evidence.mjs copy",
    "evidence:verify": "node scripts/migrate-evidence.mjs verify",
    "test:skills": "node scripts/validate-creator-skill-system.mjs",
    "knowledge-v1:fixture": "tsx scripts/content-knowledge-v1-fixture.ts",
    "wave4:content-packages": "tsx scripts/wave4-content-packages.ts",
    "smoke:entrypoints": "node scripts/smoke-entrypoints.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "verify": "npm run check:docs && npm run check:repo && npm run check:knowledge-authority && npm run check:artifacts && npm run typecheck && npm test && npm run test:workflow && npm run lint && npm run build && npm run smoke:entrypoints",
    "start": "SELF_MEDIA_WEB_URL=http://127.0.0.1:4310 NODE_ENV=production node dist-server/apps/api/src/main.js",
    "start:worker": "NODE_ENV=production node dist-server/apps/worker/src/main.js",
    "build:workflow": "npm run build -w @signal-room/workflow && npm run build -w @signal-room/workflow-codex && npm run build -w @signal-room/workflow-sqlite && npm run build -w @signal-room/workflow-read-model",
    "prepare": "npm run build:workflow",
    "predev": "npm run build:workflow",
    "predev:api": "npm run build:workflow",
    "predev:web": "npm run build:workflow",
    "predev:worker": "npm run build:workflow",
    "preworker": "npm run build:workflow",
    "preselfmedia": "npm run build:workflow",
    "pretypecheck": "npm run build:workflow",
    "pretest": "npm run build:workflow",
    "test:workflow": "vitest run --config vendor/agent-workflow/vitest.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.6",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "undici": "^7.29.0",
    "zod": "^3.25.76",
    "@signal-room/workflow": "0.1.0",
    "@signal-room/workflow-codex": "0.1.0",
    "@signal-room/workflow-sqlite": "0.1.0",
    "@signal-room/workflow-read-model": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
