{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-server",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": ["apps/api", "apps/worker", "apps/cli", "packages", "src/core", "src/server", "src/cli", "src/shared"],
  "exclude": ["src/**/*.test.ts", "packages/**/*.test.ts"]
}
