# Optional override. The X adapter also checks the existing external twitter-mcp .env.
TWITTER_API_KEY=

# Optional command template for timestamped transcription.
# Available placeholders: {input}, {output}
SELF_MEDIA_TRANSCRIBE_CMD=

# Runtime paths and ports
SELF_MEDIA_RUNTIME_DIR=.runtime
SELF_MEDIA_PORT=4310
SELF_MEDIA_WEB_URL=http://127.0.0.1:5173

