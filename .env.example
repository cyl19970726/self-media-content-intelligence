# Optional override. The X adapter also checks the existing external twitter-mcp .env.
TWITTER_API_KEY=

# Optional command template for timestamped transcription.
# Available placeholders: {input}, {output}
SELF_MEDIA_TRANSCRIBE_CMD=

# Runtime paths and ports
SELF_MEDIA_RUNTIME_DIR=.runtime
SELF_MEDIA_PORT=4310
SELF_MEDIA_WEB_URL=http://127.0.0.1:5173

# Internal browser worker executable. Users submit links from the Dashboard;
# the server invokes this adapter in the background.
SELF_MEDIA_EGO_BROWSER_BIN=ego-browser

# Optional portable overrides for local skills/adapters.
SELF_MEDIA_VIDEO_RECONSTRUCTION_SKILL_DIR=
SELF_MEDIA_MEDIA_SKILL_DIR=
SELF_MEDIA_CREATOR_ANALYSIS_SKILL=
SELF_MEDIA_XHS_CLI=
SELF_MEDIA_TWITTER_ENV=
SELF_MEDIA_TRANSCRIBE_SCRIPT=

# Optional RedFox public-data provider. Keep the real key in ignored .env only.
REDFOX_API_KEY=
REDFOX_BASE_URL=https://redfox.hk
REDFOX_REQUEST_TIMEOUT_MS=60000
# Optional when the server network must use an explicit HTTP proxy.
REDFOX_PROXY_URL=
