# Optional override. The X adapter also checks the existing external twitter-mcp .env.
TWITTER_API_KEY=

# Optional command template for timestamped transcription.
# Available placeholders: {input}, {output}
SELF_MEDIA_TRANSCRIBE_CMD=

# Runtime paths and ports
SELF_MEDIA_RUNTIME_DIR=.runtime
SELF_MEDIA_PORT=4310
SELF_MEDIA_WEB_URL=http://127.0.0.1:5173

# Independent content-addressed research Evidence store.
SIGNAL_ROOM_EVIDENCE_ROOT=/absolute/path/to/self-media-evidence

# Internal browser worker executable. Users submit links from the Dashboard;
# the server invokes this adapter in the background.
SELF_MEDIA_EGO_BROWSER_BIN=ego-browser

# Optional portable overrides for local skills/adapters.
# Optional override; defaults to the versioned .agents/skills/video-content-reconstruction.
SELF_MEDIA_VIDEO_RECONSTRUCTION_SKILL_DIR=
SELF_MEDIA_VIDEO_EVALUATION_POLICY=skip
SELF_MEDIA_BUILDER_MODEL=gpt-5.6-terra
SELF_MEDIA_BUILDER_REASONING_EFFORT=medium
SELF_MEDIA_EVALUATOR_MODEL=gpt-5.6-terra
SELF_MEDIA_EVALUATOR_REASONING_EFFORT=medium
# Host-side media preparation. Mandarin is explicit so an English-only model can never silently translate it.
SELF_MEDIA_TRANSCRIPTION_LANGUAGE=zh
SELF_MEDIA_WHISPER_CLI=whisper-cli
SELF_MEDIA_WHISPER_MODEL=
SELF_MEDIA_PYTHON_WHISPER=whisper
# Keep normal jobs ephemeral. Set false only for a bounded diagnostic sample, then restore true.
SELF_MEDIA_CODEX_EPHEMERAL=true
SELF_MEDIA_MEDIA_SKILL_DIR=
SELF_MEDIA_CREATOR_ANALYSIS_SKILL=
SELF_MEDIA_XHS_CLI=
SELF_MEDIA_TWITTER_ENV=
SELF_MEDIA_TRANSCRIBE_SCRIPT=

# Creator Pipeline V2 worker pools. Keep ego-browser at 1 when sharing one login profile.
SELF_MEDIA_REDFOX_CONCURRENCY=4
SELF_MEDIA_EGO_BROWSER_CONCURRENCY=1
SELF_MEDIA_PORTFOLIO_CONCURRENCY=1
SELF_MEDIA_VIDEO_CONCURRENCY=3
SELF_MEDIA_SYNTHESIS_CONCURRENCY=2

# Optional RedFox public-data provider. Keep the real key in ignored .env only.
REDFOX_API_KEY=
REDFOX_BASE_URL=https://redfox.hk
REDFOX_REQUEST_TIMEOUT_MS=60000
