      {
        "id": "CUE-035",
        "start": 200.98,
        "end": 206.47,
        "text": "你又不是颜值博主的话，请善用你的点赞和收藏",
        "representativeFrame": "frames/cues/cue-035.jpg",
        "overlappingShots": [
          "SHOT-001"
