        "representativeFrame": "frames/cues/cue-018.jpg",
        "overlappingShots": [
          "SHOT-001"
        ]
      },
      {
        "id": "CUE-019",
        "start": 103.07,
        "end": 109.32,
        "text": "请不要听信那些所谓养号活跃度系统判定你是活人",
        "representativeFrame": "frames/cues/cue-019.jpg",
        "overlappingShots": [
          "SHOT-001"
