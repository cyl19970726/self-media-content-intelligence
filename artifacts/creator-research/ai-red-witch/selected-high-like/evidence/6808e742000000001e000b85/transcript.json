    },
    {
      "id": "CUE-022",
      "index": 22,
      "start": 80.168,
      "end": 84.26,
      "duration": 4.092,
      "midpoint": 82.214,
      "text": "趁现在它还属于免费开源的阶段，我强烈建议你们赶紧去试试"
