{
  "id": "69424c0d000000001e039745",
  "cues": [
    {
      "id": "CUE-001",
      "index": 1,
      "start": 0,
      "end": 4.72,
      "duration": 4.72,
      "midpoint": 2.36,
      "text": "近日湖北襄阳十九岁大二学生突发脑梗，入院时左侧肢体基本上全瘫了，口齿不清"
    },
    {
      "id": "CUE-002",
      "index": 2,
      "start": 4.72,
      "end": 7.49,
      "duration": 2.77,
      "midpoint": 6.105,
      "text": "发现患者经常熬夜。通宵点外卖吃油腻的东西"
    },
    {
      "id": "CUE-003",
      "index": 3,
      "start": 7.49,
      "end": 10.019,
      "duration": 2.529,
      "midpoint": 8.755,
      "text": "熬夜吃的油腻，这不就是我吗？"
    },
    {
      "id": "CUE-004",
      "index": 4,
      "start": 10.019,
      "end": 14.54,
      "duration": 4.521,
      "midpoint": 12.279,
      "text": "每天都在假装关心自己的健康，但问题是在网上根本不知道该相信谁"
    },
    {
      "id": "CUE-005",
      "index": 5,
      "start": 14.55,
      "end": 19.192,
      "duration": 4.642,
      "midpoint": 16.871,
      "text": "你是不是跟我一样，凌晨一点还在刷着手机，想认真查一个健康问题"
    },
    {
      "id": "CUE-006",
      "index": 6,
      "start": 19.192,
      "end": 21.61,
      "duration": 2.418,
      "midpoint": 20.401,
      "text": "结果搜出来的答案一个比一个吓人"
    },
    {
      "id": "CUE-007",
      "index": 7,
      "start": 21.62,
      "end": 26.622,
      "duration": 5.002,
      "midpoint": 24.121,
      "text": "一个个还不一样，越看越焦虑，而我只是想知道白天靠咖啡顶着算不算透支"
    },
    {
      "id": "CUE-008",
      "index": 8,
      "start": 26.622,
      "end": 28.64,
      "duration": 2.018,
      "midpoint": 27.631,
      "text": "这种强度的运动算不算太狠"
    },
    {
      "id": "CUE-009",
      "index": 9,
      "start": 28.65,
      "end": 31.958,
      "duration": 3.308,
      "midpoint": 30.304,
      "text": "最近啊总是觉得累，注意力不够集中，是不是该调整一下"
    },
    {
      "id": "CUE-010",
      "index": 10,
      "start": 31.958,
      "end": 37.038,
      "duration": 5.08,
      "midpoint": 34.498,
      "text": "但这些问题貌似又不值得专门跑一趟，就在最近我体会到了一种完全不同的方式"
    },
    {
      "id": "CUE-011",
      "index": 11,
      "start": 37.038,
      "end": 38.61,
      "duration": 1.572,
      "midpoint": 37.824,
      "text": "哒哒我的健康搭子"
    },
    {
      "id": "CUE-012",
      "index": 12,
      "start": 38.62,
      "end": 42.927,
      "duration": 4.307,
      "midpoint": 40.773,
      "text": "是蚂蚁集团推出的ai应用阿福，我跟他聊聊最近的身体的感受"
    },
    {
      "id": "CUE-013",
      "index": 13,
      "start": 42.927,
      "end": 44.57,
      "duration": 1.643,
      "midpoint": 43.748,
      "text": "他并没有急着给我下结论"
    },
    {
      "id": "CUE-014",
      "index": 14,
      "start": 44.58,
      "end": 48.679,
      "duration": 4.099,
      "midpoint": 46.63,
      "text": "而是先顺着我的情况继续往下问，比如我跟他说最近的身体总是很累"
    },
    {
      "id": "CUE-015",
      "index": 15,
      "start": 48.679,
      "end": 50.66,
      "duration": 1.981,
      "midpoint": 49.669,
      "text": "他会先问我身体的其他感受"
    },
    {
      "id": "CUE-016",
      "index": 16,
      "start": 50.67,
      "end": 55.187,
      "duration": 4.517,
      "midpoint": 52.928,
      "text": "比如说睡眠时长，还有哪里觉得不舒服等等，也就说我白天全靠咖啡撑着"
    },
    {
      "id": "CUE-017",
      "index": 17,
      "start": 55.187,
      "end": 58.78,
      "duration": 3.593,
      "midpoint": 56.983,
      "text": "他会追问一天大概喝多少杯，再告诉我不加量就行"
    },
    {
      "id": "CUE-018",
      "index": 18,
      "start": 58.79,
      "end": 63.303,
      "duration": 4.513,
      "midpoint": 61.046,
      "text": "女生嘛，都想做好身材管理，我跟她说完自己的体重啊，身高啊等信息"
    },
    {
      "id": "CUE-019",
      "index": 19,
      "start": 63.303,
      "end": 68.56,
      "duration": 5.257,
      "midpoint": 65.931,
      "text": "她还会确认我平时的运动频率啊，饮食习惯啊什么的，再告诉我需要增加力量训练"
    },
    {
      "id": "CUE-020",
      "index": 20,
      "start": 68.57,
      "end": 73.73,
      "duration": 5.16,
      "midpoint": 71.15,
      "text": "饮食怎么搭配等等，这种体验跟平时去网站解锁信息完全不一样，大家都知道"
    },
    {
      "id": "CUE-021",
      "index": 21,
      "start": 73.74,
      "end": 77.534,
      "duration": 3.794,
      "midpoint": 75.637,
      "text": "健康相关的咨询没有标准答案，把问题一步步的梳理清楚"
    },
    {
      "id": "CUE-022",
      "index": 22,
      "start": 77.534,
      "end": 82.26,
      "duration": 4.726,
      "midpoint": 79.897,
      "text": "还有一些以前想要坚持但又总是断掉的小目标，我们也可以用它来记录"
    },
    {
      "id": "CUE-023",
      "index": 23,
      "start": 82.27,
      "end": 86.91,
      "duration": 4.64,
      "midpoint": 84.59,
      "text": "比如坚持十二点前睡觉，睡觉前五分钟放松冥想，你看他不会催你"
    },
    {
      "id": "CUE-024",
      "index": 24,
      "start": 86.91,
      "end": 89.5,
      "duration": 2.59,
      "midpoint": 88.205,
      "text": "只是想让你意识到。你已经在慢慢的变好"
    },
    {
      "id": "CUE-025",
      "index": 25,
      "start": 89.5,
      "end": 93.66,
      "duration": 4.16,
      "midpoint": 91.58,
      "text": "阿福之所以这么客气，是因为他一直在用很高的专业标准在做健康管理"
    },
    {
      "id": "CUE-026",
      "index": 26,
      "start": 93.66,
      "end": 96.5,
      "duration": 2.84,
      "midpoint": 95.08,
      "text": "只是提供参考，绝不制造恐慌，一整个靠谱"
    },
    {
      "id": "CUE-027",
      "index": 27,
      "start": 96.51,
      "end": 101.19,
      "duration": 4.68,
      "midpoint": 98.85,
      "text": "我们这一代的打工人真正缺的就是这样一个能够看见你，也能够真正回应你"
    },
    {
      "id": "CUE-028",
      "index": 28,
      "start": 101.19,
      "end": 105.6,
      "duration": 4.41,
      "midpoint": 103.395,
      "text": "并且能够完全确保你隐私的健康，搭子，你最想问的一个健康的问题是什么？"
    }
  ]
}
