        "end": 15.72,
        "text": "第一遍你用一个语音书法",
        "representativeTime": 14.88,
        "representativeFrame": "frames/cues/cue-005.jpg",
        "overlappingShots": [
          "SHOT-001"
        ]
      },
      {
        "id": "CUE-006",
        "start": 15.72,
        "end": 17.92,
        "text": "比如说豆包书法或者Type-list",
