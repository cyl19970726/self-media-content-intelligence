    {
      "id": "CUE-050",
      "index": 50,
      "start": 133.45,
      "end": 136.634,
      "duration": 3.184,
      "midpoint": 135.042,
      "text": "可以告诉你的是，如果你发现你做出了一个爆款系列的时候"
