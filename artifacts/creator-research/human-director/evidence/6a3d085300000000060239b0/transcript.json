    {
      "id": "CUE-067",
      "index": 67,
      "start": 180.366,
      "end": 181.633,
      "duration": 1.267,
      "midpoint": 181,
      "text": "我知道他们想看什么"
    },
    {
      "id": "CUE-068",
      "index": 68,
      "start": 181.633,
      "end": 186,
      "duration": 4.367,
      "midpoint": 183.817,
      "text": "他们爱看什么和提问去获得选题的灵感，我反复强调自媒体做自他媒体"
