{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-content-reconstruction/ocr-evidence.schema.json",
  "title": "Frame OCR evidence",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "manifest", "recognitionLanguages", "frames"],
  "properties": {
    "schemaVersion": { "const": "ocr-evidence-1.0" },
    "generatedAt": { "type": "string" },
    "manifest": { "type": "string" },
    "recognitionLanguages": { "type": "array", "items": { "type": "string" } },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frameId", "actionId", "time", "sourceFrame", "status", "lines"],
        "properties": {
          "frameId": { "type": "string" },
          "actionId": { "type": "string" },
          "time": { "type": "number" },
          "sourceFrame": { "type": "string" },
          "status": { "enum": ["processed", "failed"] },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text", "confidence", "boundingBox"],
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "boundingBox": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } }
              }
            }
          },
          "error": { "type": ["string", "null"] }
        }
      }
    }
  }
}
